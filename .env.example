# Copy to .env only for local development. Never commit actual credentials.
# Production values belong in Hostinger Environment Variables.
NODE_ENV=production
PORT=3000
APP_URL=https://lightcyan-butterfly-517770.hostingersite.com
# Hostinger reverse proxy; confirm hop count against actual deployment.
TRUST_PROXY_HOPS=1

# Required: choose your own password (at least 12 characters).
APP_USERNAME=hamdanfaiz
APP_PASSWORD=
APP_USER_NAME=Hamdan Faiz
APP_USER_ROLE=Administrator
# Required: random secret at least 32 characters. Do not reuse the password.
SESSION_SECRET=
# Optional additional users: username:password:display name:role
APP_USERS=

# Production storage. Use the exact database/user names from Hostinger.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Empty business data by default; sample data is only for demonstrations.
INITIAL_DATA_MODE=empty
ENABLE_DATABASE_RESET=false

# Development only: NODE_ENV=development and an absolute DATA_DIR outside app root.
# DATA_DIR=C:/path/to/local-expansion-hub-data
